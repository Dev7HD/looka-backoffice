# Copy to .env.local and fill in. All client vars must be prefixed VITE_.

# Backend REST base URL. Defaults to /api.
VITE_API_BASE_URL=/api
# Set to "false" to hit a real backend instead of in-memory fixtures.
VITE_USE_MOCK_API=true

# Realtime dispatch feed (WebSocket, through the edge-gateway).
VITE_WS_URL=
# Set to "false" to use the real socket instead of the simulated feed.
VITE_USE_MOCK_WS=true

# Mapbox GL access token. When set, the POI geofence editor uses real Mapbox
# tiles + draw controls. When empty, it falls back to the offline SVG editor.
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token
# Optional style override (default: mapbox://styles/mapbox/light-v11).
#VITE_MAPBOX_STYLE=

# Auth mode: "keycloak" (real SSO) or "mock" (in-app dev login). Default: mock.
VITE_AUTH_MODE=keycloak
# Keycloak connection — required when VITE_AUTH_MODE=keycloak.
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=louka
VITE_KEYCLOAK_CLIENT_ID=backoffice

# Firebase Cloud Messaging (web push). When set, the back-office registers a
# web FCM token and receives operational alerts. Leave empty to disable.
VITE_FCM_API_KEY=
VITE_FCM_AUTH_DOMAIN=
VITE_FCM_PROJECT_ID=
VITE_FCM_SENDER_ID=
VITE_FCM_APP_ID=
VITE_FCM_VAPID_KEY=
